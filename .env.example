# Podcasterium — local environment. Copy to .env (git-ignored) and fill in.
# Nothing here is committed with a real value; secrets live only in .env,
# in the Cloudflare Pages project, or in the store consoles.

# --- Supabase (https://api.podcasterium.com) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Cloudflare (zone of podcasterium.com; deploy.sh purges it) ---
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# --- Search (https://search.podcasterium.com) ---
MEILI_URL=

# --- RevenueCat public SDK keys (client-embeddable, project "Podcasterium") ---
RC_PUBLIC_SDK_KEY_IOS=
RC_PUBLIC_SDK_KEY_ANDROID=

# --- Telegram nightly notifications (Podcasterium's own group) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
